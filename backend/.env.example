# Copy this file to .env and adapt the values (never commit .env)
APP_NAME=SensorHub API
DEBUG=true
DATABASE_URL=sqlite:///./sensorhub.db

# Generate a random key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MIN=60

# First administrator, created at startup if the user table is empty
ADMIN_EMAIL=admin@altranodes.example
ADMIN_PASSWORD=ChangeMe-2026!

# MQTT broker (development: local Mosquitto without authentication)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# CORS: not needed with the Vite proxy (dev) or behind nginx (prod), where front and back share the origin
CORS_ORIGINS=[]
