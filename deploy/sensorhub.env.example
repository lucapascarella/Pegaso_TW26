# /etc/sensorhub/sensorhub.env  (chmod 640, owner root:sensorhub)
APP_NAME=SensorHub API
DEBUG=false
DATABASE_URL=sqlite:////var/lib/sensorhub/sensorhub.db

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MIN=60

ADMIN_EMAIL=admin@altranodes.example
ADMIN_PASSWORD=

# Local broker on loopback (see deploy/mosquitto/prod.conf)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_TLS=false

# Same origin behind nginx: CORS not needed
CORS_ORIGINS=[]
